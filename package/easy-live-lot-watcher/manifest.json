{
  "manifest_version": 3,
  "name": "Easy Live Lot Watcher",
  "version": "0.7.0",
  "description": "Live and timed auction alerts with optional always-on Railway cloud monitoring.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "power",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://api.pushover.net/*",
    "https://*.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Easy Live Lot Watcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
